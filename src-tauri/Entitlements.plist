<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime that notarization requires. The
  hardened runtime denies camera access unless it is declared here, which
  would break the TOTP QR scanner in signed builds. Nothing else is
  needed: FIDO2 keys go through IOKit HID, which the hardened runtime
  does not restrict.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
